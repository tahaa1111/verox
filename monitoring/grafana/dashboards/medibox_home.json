{
  "title": "MediBox — Unified",
  "uid": "medibox-home",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["medibox"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Data Source"
      }
    ]
  },

  "panels": [

    { "id": 1, "type": "stat", "title": "Active Pi Devices",
      "description": "Devices that pushed a camera frame in the last 30 s",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "active_devices_total", "legendFormat": "devices", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 2, "type": "stat", "title": "Jobs Completed Today",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(ocr_jobs_total{status=\"completed\"}[24h]))", "legendFormat": "completed", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 3, "type": "stat", "title": "arq Queue Depth",
      "description": "Jobs waiting for the Railway worker right now",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "ocr_queue_depth", "legendFormat": "queued", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 4, "type": "stat", "title": "API Error Rate",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) * 100", "legendFormat": "error %", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}, "unit": "percent", "decimals": 2, "noValue": "0%"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 5, "type": "stat", "title": "API p95 Latency",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95 ms", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1500}]}, "unit": "ms", "decimals": 0, "noValue": "-"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 6, "type": "stat", "title": "Auth Failures (1 h)",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(auth_failures_total[1h]))", "legendFormat": "failures", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },

    { "id": 10, "type": "row", "title": "OCR Pipeline", "gridPos": {"x": 0, "y": 4, "w": 24, "h": 1}, "collapsed": false, "panels": [] },

    { "id": 11, "type": "timeseries", "title": "Job Throughput (by status)",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(ocr_jobs_total{status=\"completed\"}[5m]))", "legendFormat": "completed/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(ocr_jobs_total{status=\"queued\"}[5m]))", "legendFormat": "queued/s", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(ocr_jobs_total{status=\"failed\"}[5m]))", "legendFormat": "failed/s", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(ocr_jobs_total{status=\"cancelled\"}[5m]))", "legendFormat": "cancelled/s", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10, "drawStyle": "line"}, "unit": "reqps"}, "overrides": [
        {"matcher": {"id": "byName", "options": "completed/s"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
        {"matcher": {"id": "byName", "options": "failed/s"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    { "id": 12, "type": "timeseries", "title": "End-to-End Processing Time",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.50, sum(rate(ocr_processing_seconds_bucket[10m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum(rate(ocr_processing_seconds_bucket[10m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.99, sum(rate(ocr_processing_seconds_bucket[10m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 0, "drawStyle": "line"}, "unit": "s"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    { "id": 13, "type": "timeseries", "title": "Queue Depth",
      "gridPos": {"x": 0, "y": 13, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "ocr_queue_depth", "legendFormat": "depth", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}, "custom": {"lineWidth": 2, "fillOpacity": 20, "drawStyle": "line"}, "unit": "short", "min": 0}, "overrides": []},
      "options": {"tooltip": {"mode": "single"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    { "id": 14, "type": "timeseries", "title": "Inference Latency (Qwen / RunPod)",
      "gridPos": {"x": 8, "y": 13, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.50, sum(rate(ocr_inference_latency_seconds_bucket[10m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum(rate(ocr_inference_latency_seconds_bucket[10m])) by (le))", "legendFormat": "p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 0, "drawStyle": "line"}, "unit": "s"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    { "id": 15, "type": "timeseries", "title": "Human Corrections & Retries",
      "gridPos": {"x": 16, "y": 13, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(corrections_total[10m]))", "legendFormat": "corrections/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(pipeline_retries_total[5m]))", "legendFormat": "retries/s", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10, "drawStyle": "line"}, "unit": "reqps"}, "overrides": [
        {"matcher": {"id": "byName", "options": "retries/s"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
      ]},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },

    { "id": 20, "type": "row", "title": "API Traffic", "gridPos": {"x": 0, "y": 19, "w": 24, "h": 1}, "collapsed": false, "panels": [] },

    { "id": 21, "type": "timeseries", "title": "HTTP Request Rate (by status class)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(http_requests_total{status_code=~\"2..\"}[1m]))", "legendFormat": "2xx", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(http_requests_total{status_code=~\"4..\"}[1m]))", "legendFormat": "4xx", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m]))", "legendFormat": "5xx", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10, "drawStyle": "line"}, "unit": "reqps"}, "overrides": [
        {"matcher": {"id": "byName", "options": "2xx"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
        {"matcher": {"id": "byName", "options": "4xx"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
        {"matcher": {"id": "byName", "options": "5xx"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean"]}}
    },
    { "id": 22, "type": "timeseries", "title": "Latency Percentiles (p50 / p95 / p99)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 0, "drawStyle": "line"}, "unit": "s"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    { "id": 23, "type": "timeseries", "title": "Latency by Endpoint (p95)",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))", "legendFormat": "{{endpoint}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 0, "drawStyle": "line"}, "unit": "s"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}}
    },

    { "id": 30, "type": "row", "title": "Security", "gridPos": {"x": 0, "y": 35, "w": 24, "h": 1}, "collapsed": false, "panels": [] },

    { "id": 31, "type": "stat", "title": "Auth Failures (1 h)",
      "gridPos": {"x": 0, "y": 36, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(auth_failures_total[1h]))", "legendFormat": "failures", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 32, "type": "stat", "title": "Rate Limit Hits (1 h)",
      "gridPos": {"x": 6, "y": 36, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(rate_limit_hits_total[1h]))", "legendFormat": "hits", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 33, "type": "stat", "title": "Brute Force Events (1 h)",
      "gridPos": {"x": 12, "y": 36, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(suspicious_requests_total{type=\"brute_force\"}[1h]))", "legendFormat": "events", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 34, "type": "stat", "title": "Blocked IP Attempts (1 h)",
      "gridPos": {"x": 18, "y": 36, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(suspicious_requests_total{type=\"blocked_ip_attempt\"}[1h]))", "legendFormat": "attempts", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}, "unit": "short", "noValue": "0"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}}
    },
    { "id": 35, "type": "timeseries", "title": "Auth Failures by Reason",
      "gridPos": {"x": 0, "y": 40, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(auth_failures_total[5m])) by (reason)", "legendFormat": "{{reason}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10, "drawStyle": "line"}, "unit": "reqps"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}}
    },
    { "id": 36, "type": "timeseries", "title": "Rate Limit Hits by Layer",
      "description": "Layers: ip | user | device | burst",
      "gridPos": {"x": 12, "y": 40, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(rate_limit_hits_total[5m])) by (layer)", "legendFormat": "{{layer}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10, "drawStyle": "line"}, "unit": "reqps"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    { "id": 37, "type": "timeseries", "title": "Suspicious Activity Timeline",
      "gridPos": {"x": 0, "y": 48, "w": 24, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(suspicious_requests_total{type=\"brute_force\"}[5m]))", "legendFormat": "brute force", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(suspicious_requests_total{type=\"blocked_ip_attempt\"}[5m]))", "legendFormat": "blocked IP attempts", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(auth_failures_total[5m]))", "legendFormat": "auth failures", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(rate_limit_hits_total[5m]))", "legendFormat": "rate limit hits", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 8, "drawStyle": "line"}, "unit": "reqps"}, "overrides": [
        {"matcher": {"id": "byName", "options": "brute force"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "dark-red"}}]},
        {"matcher": {"id": "byName", "options": "auth failures"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}, "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"]}}
    },

    { "id": 40, "type": "row", "title": "Edge Devices (Pi 5 — pi-0001)", "gridPos": {"x": 0, "y": 55, "w": 24, "h": 1}, "collapsed": false, "panels": [] },

    { "id": 41, "type": "timeseries", "title": "Active Devices Over Time",
      "gridPos": {"x": 0, "y": 56, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "active_devices_total", "legendFormat": "active devices", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "custom": {"lineWidth": 2, "fillOpacity": 20, "drawStyle": "line"}, "unit": "short", "min": 0}, "overrides": []},
      "options": {"tooltip": {"mode": "single"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    { "id": 42, "type": "timeseries", "title": "Camera Heartbeat Delay (p50 / p95)",
      "gridPos": {"x": 8, "y": 56, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.50, sum(rate(device_heartbeat_delay_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum(rate(device_heartbeat_delay_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 0, "drawStyle": "line"}, "unit": "s"}, "overrides": []},
