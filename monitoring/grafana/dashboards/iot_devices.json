{
  "title": "Medibox — IoT Devices",
  "uid": "medibox-iot",
  "tags": ["medibox", "iot"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Active Devices",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "active_devices_total", "legendFormat": "active" }],
      "options": {
        "colorMode": "background",
        "thresholds": { "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 1 }
        ]}
      }
    },
    {
      "id": 2, "type": "stat", "title": "Heartbeat p95 Delay",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(device_heartbeat_delay_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "options": {
        "colorMode": "background",
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "red", "value": 15 }
        ]}
      }
    },
    {
      "id": 3, "type": "timeseries", "title": "Active Devices Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "active_devices_total", "legendFormat": "active devices" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Device Heartbeat Delay",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(device_heartbeat_delay_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(device_heartbeat_delay_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    }
  ]
}
