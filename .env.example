# =============================================================================
# Medibox Cloud — Environment Variables
# Copy to .env for local dev. On Railway: set via dashboard or railway vars.
# CRITICAL: Never commit the real .env file. .env is in .gitignore.
# =============================================================================

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Full Neon connection string — takes priority over individual DB_* vars
DATABASE_URL_OVERRIDE=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# CELERY_BROKER_URL — removed (Celery replaced by arq)

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Paste the entire service account JSON as a single-line string
FIREBASE_ADMIN_JSON={"type":"service_account","project_id":"...","private_key":"..."}
FIREBASE_PROJECT_ID=verox-4dc3f

# ── PII Encryption (Fernet) ───────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=<base64url-32-byte-fernet-key>
# Previous key — set when rotating; leave empty on first deploy
PII_ENCRYPTION_KEY_PREV=

# ── Cloudflare R2 (S3-compatible) ─────────────────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_KEY=<r2-secret-key>
R2_BUCKET=medibox-crops

# ── RunPod / vLLM ─────────────────────────────────────────────────────────────
VLLM_URL=https://<runpod-pod-id>-8000.proxy.runpod.net
VLLM_API_KEY=<runpod-api-key>
VLLM_MODEL=qwen2.5-vl-7b-instruct

# ── Camera relay HMAC ─────────────────────────────────────────────────────────
# Pi edge devices use this secret to authenticate WebSocket camera push
CAMERA_SECRET=<random-32-char-secret>

# ── arq worker tuning ─────────────────────────────────────────────────────────
# How often the in-process worker polls the Redis queue for new jobs.
# Default arq value: 0.5s → ~5.18M Redis commands/month (blows Upstash free tier).
# 2.0s → ~1.3M/month. Set higher if the service is expected to be mostly idle.
ARQ_POLL_DELAY=2.0

# ── Observability: Grafana Cloud OTLP push ────────────────────────────────────
# Traces AND metrics are pushed from the process via OTLP/HTTP — no scrape endpoint.
# Grafana Cloud's backend is Prometheus-compatible; PromQL / alerts unchanged.
#
# 1. In Grafana Cloud: Connections → Add connection → OpenTelemetry (OTLP)
# 2. Generate a token with scopes: traces:write  metrics:write
# 3. Note the numeric Instance ID (stack ID) shown on the OTLP config page.
#
# Endpoint format: https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=<numeric-instance-id>
GRAFANA_CLOUD_TOKEN=<grafana-cloud-token-traces-write-metrics-write>

# ── Sentry (error tracking — separate from OTel) ──────────────────────────────
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DOMAIN=verox-five.vercel.app
LOG_LEVEL=info

# ── Admin bootstrap (one-time) ────────────────────────────────────────────────
# Set to first admin Firebase UID on first deploy; unset after — see MIGRATION.md
ADMIN_BOOTSTRAP_UID=

# ── Rate limiting overrides (optional) ────────────────────────────────────────
# RATE_LIMIT_PER_IP=200
# RATE_LIMIT_PER_USER=60
# RATE_LIMIT_PER_DEVICE=30
# RATE_LIMIT_BURST=50

# ── GPU quota ─────────────────────────────────────────────────────────────────
GPU_DAILY_LIMIT_PER_USER=50
